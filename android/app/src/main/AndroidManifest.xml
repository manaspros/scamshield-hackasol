<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Optional, demo phones only: adb shell pm grant com.hackasol.scamshield android.permission.WRITE_SECURE_SETTINGS -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Lists the phone's own call recordings on the Check-a-recording screen (read only). -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <application
        android:label="ScamShield"
        android:largeHeap="true"
        android:hasFragileUserData="true"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- T2.7: share a call recording to ScamShield; RecordingChannel.handleShare takes the Uri -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ShareReceiver"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.android.package-archive" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>
        <service
            android:name=".CaptionAccessibilityService"
            android:exported="true"
            android:label="ScamShield call protection"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/caption_accessibility_service" />
        </service>
        <service
            android:name=".ScamNotificationListener"
            android:exported="true"
            android:label="ScamShield message protection"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- Evidence ZIP sharing (T5.5): only cache/evidence/ is exposed, see res/xml/file_paths.xml -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- MediaPipe LLM inference may use the GPU OpenCL driver when present. -->
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- The TextToSpeech engine: without this, package visibility (Android 11+) hides it and read-aloud never speaks. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- Remote-access and payment apps from InCallSignals (REMOTE_APPS, PAYMENT_APPS): visible so an install during a
             call is reported (PACKAGE_ADDED) and its label and permissions can be read. Keep in sync with InCallSignals.kt. -->
        <package android:name="com.anydesk.anydeskandroid" />
        <package android:name="com.axis.mobile" />
        <package android:name="com.carriez.flutter_hbb" />
        <package android:name="com.csam.icici.bank.imobile" />
        <package android:name="com.dreamplug.androidapp" />
        <package android:name="com.freecharge.android" />
        <package android:name="com.google.android.apps.nbu.paisa.user" />
        <package android:name="com.google.chromeremotedesktop" />
        <package android:name="com.microsoft.quickassist" />
        <package android:name="com.mobikwik_new" />
        <package android:name="com.myairtelapp" />
        <package android:name="com.phonepe.app" />
        <package android:name="com.rustdesk.rustdesk" />
        <package android:name="com.sand.airdroid" />
        <package android:name="com.sand.airdroidbiz" />
        <package android:name="com.sand.airmirror" />
        <package android:name="com.sand.airsos" />
        <package android:name="com.sbi.lotusintouch" />
        <package android:name="com.sbi.upi" />
        <package android:name="com.snapwork.hdfc" />
        <package android:name="com.teamviewer.host.market" />
        <package android:name="com.teamviewer.quicksupport.market" />
        <package android:name="com.teamviewer.teamviewer.market.mobile" />
        <package android:name="in.org.npci.upiapp" />
        <package android:name="net.one97.paytm" />
        <!-- Report chat voice typing: find the phone's speech recogniser (Google) on Android 11+ -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>
</manifest>
